# ── REQUIRED ──────────────────────────────────────────
# Your Discord bot token (from https://discord.com/developers/applications)
DISCORD_TOKEN=

# ── OPTIONAL — AI IMAGE GENERATION ────────────────────
# OpenAI API key for /image command
OPENAI_API_KEY=

# ── OPTIONAL — ARTLIST VIDEO (requires playwright) ─────
# Artlist account credentials for /video command
ARTLIST_EMAIL=
ARTLIST_PASSWORD=

# ── OPTIONAL — SYNTHESIA VIDEO ────────────────────────
# (synthesia_bot.py uses playwright login)

# ── OPTIONAL — SD2/SEEDANCE VIDEO ─────────────────────
# CometAPI bearer token for /sd2 command
COMETAPI_KEY=

# ── OPTIONAL — OREATE ──────────────────────────────────
OREATE_PASSWORD=

# ── OPTIONAL — DOLA ───────────────────────────────────
DOLA_EMAIL=

# ── OPTIONAL — STREAMABLE ─────────────────────────────
STREAMABLE_EMAIL=
STREAMABLE_PASSWORD=

# ── OPTIONAL — SERVER LOCK ────────────────────────────
# Comma-separated guild IDs the bot is allowed to operate in
# Leave empty to allow all servers (owner commands still restricted)
ALLOWED_GUILD_IDS=

# ── OPTIONAL — HEALTH CHECK PORT ──────────────────────
PORT=8000
